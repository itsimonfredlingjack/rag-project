# Svensk Ragg Backend Configuration
# Copy to .env and adjust values for your environment.
# All environment variables use CONST_ prefix.

# ═══════════════════════════════════════════════════════════════════
# Application
# ═══════════════════════════════════════════════════════════════════
CONST_APP_NAME="Svensk Ragg"
CONST_APP_VERSION="2.0.0"
CONST_DEBUG=false

# Runtime profile / corpus boundary
# Private lab keeps the mixed recovered corpus. Public demo force-enables
# Riksdagen-only paths/defaults when set to public-riksdag-demo.
CONST_PROFILE=private-swedish-legal-lab
CONST_CORPUS_SCOPE=mixed_recovered_corpus

# ═══════════════════════════════════════════════════════════════════
# Server
# ═══════════════════════════════════════════════════════════════════
CONST_HOST=127.0.0.1
CONST_PORT=8900

# ═══════════════════════════════════════════════════════════════════
# ChromaDB (Vector Database)
# ═══════════════════════════════════════════════════════════════════
CONST_CHROMADB_ENABLED=true
CONST_CHROMADB_PATH=/path/to/chromadb_data
CONST_PDF_CACHE_PATH=/path/to/pdf_cache

# ═══════════════════════════════════════════════════════════════════
# LLM Configuration
# ═══════════════════════════════════════════════════════════════════
# Ollama endpoint
CONST_LLM_BASE_URL=http://localhost:11434
CONST_LLM_TIMEOUT=120.0
CONST_SVENSK_RAGG_MODEL=gemma4:e2b
CONST_SVENSK_RAGG_FALLBACK=gemma4:e2b
CONST_GGUF_PRIMARY_MODEL=gemma4:e2b
CONST_GGUF_CONTEXT_WINDOW=4096
# 0 lets Ollama choose. Set to 4096 for the first local demo profile.
CONST_OLLAMA_NUM_CTX=4096

# ═══════════════════════════════════════════════════════════════════
# Embedding Model (Jina v3)
# ═══════════════════════════════════════════════════════════════════
CONST_EMBEDDING_MODEL=jinaai/jina-embeddings-v3
CONST_EXPECTED_EMBEDDING_DIM=1024

# ═══════════════════════════════════════════════════════════════════
# Reranking (Jina Cross-Encoder)
# ═══════════════════════════════════════════════════════════════════
CONST_RERANKING_ENABLED=false
CONST_RERANKING_MODEL=jinaai/jina-reranker-v2-base-multilingual
CONST_RERANKING_SCORE_THRESHOLD=0.1
CONST_RERANKING_TOP_N=5

# ═══════════════════════════════════════════════════════════════════
# CRAG (Corrective RAG) Pipeline
# ═══════════════════════════════════════════════════════════════════
CONST_CRAG_ENABLED=false
CONST_CRAG_ENABLE_SELF_REFLECTION=false
CONST_CRAG_GRADE_THRESHOLD=0.25
CONST_CRAG_MAX_REWRITE_ATTEMPTS=2
CONST_CRAG_GRADER_MODEL=gemma4:e2b

# ═══════════════════════════════════════════════════════════════════
# Structured Output & Critic-Revise Loop
# ═══════════════════════════════════════════════════════════════════
CONST_STRUCTURED_OUTPUT_ENABLED=true
CONST_CRITIC_REVISE_ENABLED=true
CONST_CRITIC_MAX_REVISIONS=1

# ═══════════════════════════════════════════════════════════════════
# Search Configuration
# ═══════════════════════════════════════════════════════════════════
CONST_DEFAULT_SEARCH_LIMIT=10
CONST_SEARCH_TIMEOUT=5.0
CONST_RRF_BM25_WEIGHT=1.2
CONST_RRF_K=45.0
CONST_BM25_ENABLED=true
CONST_BM25_INDEX_PATH=/path/to/data/bm25_fts5/bm25.db

# ═══════════════════════════════════════════════════════════════════
# Cutover guardrails (fail-closed once migration is verified)
# ═══════════════════════════════════════════════════════════════════
# When true, the backend fails closed if requested Jina collections are missing
# for any requested *_jina_v3_1024 collection.
CONST_CUTOVER_ENFORCE_JINA_COLLECTIONS=false

# Optional allow-list (JSON list or comma-separated) for collections that may
# fall back even with enforcement on. Keep empty for strict cutover.
CONST_CUTOVER_ALLOWED_FALLBACK_COLLECTIONS=[]

# ═══════════════════════════════════════════════════════════════════
# Stream Resumption (SSE event buffering for connection recovery)
# ═══════════════════════════════════════════════════════════════════
CONST_STREAM_RESUMPTION_ENABLED=false
CONST_STREAM_RESUMPTION_SESSION_TTL=300.0
CONST_STREAM_RESUMPTION_MAX_SESSIONS=100

# ═══════════════════════════════════════════════════════════════════
# LLM Intent Fallback (zero-shot classification for ambiguous queries)
# ═══════════════════════════════════════════════════════════════════
CONST_INTENT_LLM_FALLBACK_ENABLED=false
CONST_INTENT_LLM_FALLBACK_TIMEOUT=3.0
CONST_INTENT_LLM_FALLBACK_CONFIDENCE_THRESHOLD=0.50

# ═══════════════════════════════════════════════════════════════════
# Logging
# ═══════════════════════════════════════════════════════════════════
CONST_LOG_LEVEL=INFO
CONST_LOG_JSON=false
# CONST_LOG_FILE=/path/to/svensk-ragg.log

# ═══════════════════════════════════════════════════════════════════
# CORS (comma-separated or JSON list)
# ═══════════════════════════════════════════════════════════════════
# CONST_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ═══════════════════════════════════════════════════════════════════
# Test Configuration (not for production)
# ═══════════════════════════════════════════════════════════════════
# RUN_INTEGRATION_TESTS=1
# RUN_OLLAMA_TESTS=1
# DETERMINISTIC_EVAL=true

# ═══════════════════════════════════════════════════════════════════
# Authentication for document mutation
# ═══════════════════════════════════════════════════════════════════
# Write endpoints fail closed by default when CONST_API_KEY is not set.
# Set an API key for admin/document mutation. Use the dev bypass only for
# local, non-public experiments.
# CONST_API_KEY=your-secret-api-key-here
# CONST_ALLOW_UNAUTHENTICATED_WRITES=false
