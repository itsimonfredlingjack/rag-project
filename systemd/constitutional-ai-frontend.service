[Unit]
Description=Constitutional AI Frontend
After=network.target constitutional-ai-backend.service
Wants=constitutional-ai-backend.service

[Service]
Type=simple
WorkingDirectory=/opt/rag-project/apps/konstitutionell-frontend
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/npm run preview -- --host 0.0.0.0 --port 3003
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=default.target
