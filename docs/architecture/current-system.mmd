flowchart LR
  classDef optional fill:#f8f9fa,stroke:#94a3b8,stroke-dasharray: 5 5,color:#0f172a;
  classDef core fill:#ecfeff,stroke:#0ea5e9,color:#0f172a;
  classDef data fill:#f0fdf4,stroke:#16a34a,color:#0f172a;
  classDef edge fill:#fff7ed,stroke:#f97316,color:#0f172a;

  U[Användare]:::core --> FE[React/Vite Frontend\nSSE-klient]:::core

  subgraph API[FastAPI Backend :8900]
    IN[POST /api/svensk-rag/agent/query/stream\nLegacy: /api/constitutional/agent/query/stream]:::edge
    READY[GET /api/svensk-rag/ready\nLegacy: /api/constitutional/ready]:::edge
    DOCS[Dokument/facet-endpoints\n/api/documents/* + /collections + /stats/overview]:::edge

    ORCH[OrchestratorService.stream_query]:::core
    QSAFE[Guardrail: query safety check\n(före retrieval)]:::core
    QPROC[QueryProcessorService\nklassificering + dekontextualisering]:::core
    RETR[RetrievalService.search_with_epr]:::core
    RETRO[RetrievalOrchestrator\nEPR/routing/fusion]:::core

    RERANK[RerankingService\nfeature-flaggad]:::optional
    CRAG[CRAG/Grader\nfeature-flaggad]:::optional
    CRITIC[Critic-Revise\nfeature-flaggad]:::optional

    LLM[LLMService\nOllama/lokal modell]:::core
    OSAFE[Output guardrail\nkorrektion + läckagekontroll]:::core
  end

  subgraph DATA[Lager]
    CHROMA[ChromaDB\nJina v3 dense collections]:::data
    BM25[SQLite FTS5\nBM25 lexical index]:::data
  end

  FE --> IN
  IN --> ORCH --> QSAFE --> QPROC --> RETR --> RETRO
  RETRO --> CHROMA
  RETRO --> BM25
  RETRO -. optional .-> RERANK
  RETRO -. optional .-> CRAG
  RERANK -. optional .-> LLM
  CRAG -. optional .-> LLM
  LLM --> OSAFE
  CRITIC -. optional .-> OSAFE
  OSAFE --> SSE[SSE events tillbaka till frontend]:::edge --> FE
