# Backend API URL
# Leave empty in local/browser-forwarded development so Vite proxies /api.
# Set only when the browser can directly reach a separate backend origin.
# Production: https://your-api-domain.com
VITE_BACKEND_URL=

# Score Thresholds for Color Coding (optional)
# Documents with score >= GOOD threshold show as green
# Documents with score >= OK threshold show as yellow
# Documents below OK threshold show as red
VITE_SCORE_THRESHOLD_GOOD=0.7
VITE_SCORE_THRESHOLD_OK=0.5
